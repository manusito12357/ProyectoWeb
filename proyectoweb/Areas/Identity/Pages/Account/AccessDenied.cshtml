@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="card tarjeta-acceso text-center">
    <div class="card-body p-4">
        <h1 class="h3">@ViewData["Title"]</h1>
        <p class="text-muted">No tienes permiso para ver esta página.</p>
        <a asp-area="" asp-controller="Catalogo" asp-action="Index" class="btn btn-primary">Volver al catálogo</a>
    </div>
</div>
