@model CatalogoViewModel

@{
    ViewData["Title"] = "Catálogo de cursos";

    string TextoLecciones(int cantidad) => cantidad switch
    {
        0 => "sin lecciones",
        1 => "1 lección",
        _ => cantidad + " lecciones"
    };
}

<div class="encabezado-pagina">
    <h1>Catálogo de cursos</h1>
    <p class="text-muted mb-0">
        @(Model.Total == 1 ? "1 curso gratuito" : Model.Total + " cursos gratuitos")@(string.IsNullOrEmpty(Model.Buscar) ? "" : " para “" + Model.Buscar + "”")
    </p>
</div>

<div class="catalogo">
    <aside class="lateral" aria-label="Filtros">
        <div class="grupo">
            <h2>Categoría</h2>
            <a class="opcion-filtro @(Model.CategoriaId == null ? "activa" : "")" asp-action="Index" asp-route-buscar="@Model.Buscar">
                Todas <span class="cantidad">@Model.Categorias.Sum(c => c.Cantidad)</span>
            </a>
            @foreach (var categoria in Model.Categorias)
            {
                <a class="opcion-filtro @(Model.CategoriaId == categoria.Id ? "activa" : "")" asp-action="Index" asp-route-categoriaId="@categoria.Id" asp-route-buscar="@Model.Buscar">
                    <span class="text-capitalize">@categoria.Nombre</span> <span class="cantidad">@categoria.Cantidad</span>
                </a>
            }
        </div>
        @if (Model.Filtrado)
        {
            <a class="limpiar-filtros" asp-action="Index">Limpiar filtros</a>
        }
    </aside>

    <section>
        @if (!Model.Cursos.Any())
        {
            <p>@(Model.Filtrado ? "No encontramos cursos con esos criterios." : "Todavía no hay cursos publicados.")</p>
            @if (Model.Filtrado)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Ver todos los cursos</a>
            }
        }
        else
        {
            <div class="lista-cursos">
                @foreach (var fila in Model.Cursos)
                {
                    var curso = fila.Curso;
                    <article class="fila-curso">
                        <div class="imagen-curso color-@(curso.Id % 5)">
                            <span>@fila.Iniciales</span>
                            @if (!string.IsNullOrEmpty(curso.ImagenUrl))
                            {
                                <img src="@curso.ImagenUrl" alt="" loading="lazy" onerror="this.remove()" />
                            }
                        </div>
                        <div>
                            <h2 class="titulo-curso"><a asp-action="Detalles" asp-route-id="@curso.Id">@curso.Titulo</a></h2>
                            <div class="datos-curso">
                                <partial name="_MedidorNivel" model="curso.Nivel" />
                                <span class="text-capitalize">@curso.Categoria?.Nombre</span>
                                <span>@curso.DuracionMinutos min</span>
                                <span>@TextoLecciones(fila.Lecciones)</span>
                            </div>
                            <p class="descripcion-curso">@curso.Descripcion</p>
                        </div>
                        <div class="lado-curso">
                            @if (fila.Terminado)
                            {
                                <span class="estado-curso terminado">Terminado</span>
                                <a asp-controller="MisCursos" asp-action="Curso" asp-route-id="@curso.Id" class="btn btn-outline-secondary">Repasar</a>
                            }
                            else if (fila.Inscrito)
                            {
                                <span class="estado-curso">@(fila.Lecciones == 0 ? "Inscrito" : "En curso, " + fila.Porcentaje + "%")</span>
                                @if (fila.Lecciones > 0)
                                {
                                    <div class="progress"><div class="progress-bar" style="width: @(fila.Porcentaje)%"></div></div>
                                }
                                <a asp-controller="MisCursos" asp-action="Curso" asp-route-id="@curso.Id" class="btn btn-destacado">Continuar</a>
                            }
                            else
                            {
                                <span class="estado-curso">Gratis</span>
                                <a asp-action="Detalles" asp-route-id="@curso.Id" class="btn btn-primary">Ver curso</a>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (Model.TotalPaginas > 1)
            {
                <nav class="mt-4" aria-label="Páginas del catálogo">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)" asp-route-buscar="@Model.Buscar" asp-route-categoriaId="@Model.CategoriaId">Anterior</a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.Pagina ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@Model.Buscar" asp-route-categoriaId="@Model.CategoriaId">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)" asp-route-buscar="@Model.Buscar" asp-route-categoriaId="@Model.CategoriaId">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>
</div>
