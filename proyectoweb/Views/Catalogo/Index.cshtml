@model IEnumerable<proyectoweb.Models.Curso>

@{
    ViewData["Title"] = "Catálogo de cursos";
}

<section class="portada">
    <h1>Aprende a tu ritmo</h1>
    <p class="lead mb-0">Microcursos y tutoriales técnicos con lecciones cortas. Inscríbete gratis y sigue tu progreso.</p>
</section>

<h2 class="h4 mb-3">Catálogo de cursos</h2>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <select name="categoriaId" class="form-select" asp-items="ViewBag.Categorias">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
    </div>
</form>

@if (!Model.Any())
{
    <p>No hay cursos publicados por ahora.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var curso in Model)
        {
            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(curso.ImagenUrl))
                    {
                        <img src="@curso.ImagenUrl" class="card-img-top card-portada" alt="@curso.Titulo" />
                    }
                    else
                    {
                        <div class="card-portada card-portada-inicial">@curso.Titulo.Substring(0, 1).ToUpper()</div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@curso.Titulo</h5>
                        <h6 class="card-subtitle mb-2 text-muted text-capitalize">@curso.Categoria?.Nombre</h6>
                        <p class="card-text">@(curso.Descripcion.Length > 140 ? curso.Descripcion[..140] + "..." : curso.Descripcion)</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <small>
                            <partial name="_EtiquetaNivel" model="curso.Nivel" />
                            <span class="text-muted ms-1">@curso.DuracionMinutos min</span>
                        </small>
                        <a asp-action="Detalles" asp-route-id="@curso.Id" class="btn btn-sm btn-primary">Ver curso</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
