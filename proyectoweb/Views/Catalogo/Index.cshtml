@model IEnumerable<proyectoweb.Models.Curso>

@{
    ViewData["Title"] = "Catálogo de cursos";
    var lecciones = (Dictionary<int, int>)ViewData["Lecciones"]!;
    var pagina = (int)ViewData["Pagina"]!;
    var totalPaginas = (int)ViewData["TotalPaginas"]!;

    string TextoLecciones(int cantidad) => cantidad switch
    {
        0 => "sin lecciones",
        1 => "1 lección",
        _ => cantidad + " lecciones"
    };
}

<section class="portada">
    <h1>Aprende a tu ritmo</h1>
    <p class="lead mb-0">Microcursos y tutoriales técnicos con lecciones cortas. Inscríbete gratis y sigue tu progreso.</p>
</section>

<h2 class="h4 mb-3">Catálogo de cursos</h2>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-12 col-md-auto">
        <input type="search" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por título" maxlength="150" />
    </div>
    <div class="col-12 col-md-auto">
        <select name="categoriaId" class="form-select" asp-items="ViewBag.Categorias">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        @if (ViewData["Filtrado"] is true)
        {
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <p>@(ViewData["Filtrado"] is true ? "No se encontraron cursos con esos criterios." : "No hay cursos publicados por ahora.")</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var curso in Model)
        {
            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(curso.ImagenUrl))
                    {
                        <img src="@curso.ImagenUrl" class="card-img-top card-portada" alt="@curso.Titulo" />
                    }
                    else
                    {
                        <div class="card-portada card-portada-inicial">@curso.Titulo.Substring(0, 1).ToUpper()</div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@curso.Titulo</h5>
                        <h6 class="card-subtitle mb-2 text-muted text-capitalize">@curso.Categoria?.Nombre</h6>
                        <p class="card-text">@(curso.Descripcion.Length > 140 ? curso.Descripcion[..140] + "..." : curso.Descripcion)</p>
                        <p class="small text-muted mb-0">@curso.DuracionMinutos min &middot; @TextoLecciones(lecciones.GetValueOrDefault(curso.Id))</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <partial name="_EtiquetaNivel" model="curso.Nivel" />
                        <a asp-action="Detalles" asp-route-id="@curso.Id" class="btn btn-sm btn-primary">Ver curso</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPaginas > 1)
    {
        <nav class="mt-4" aria-label="Páginas del catálogo">
            <ul class="pagination justify-content-center">
                <li class="page-item @(pagina == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina - 1)" asp-route-buscar="@ViewData["Buscar"]" asp-route-categoriaId="@ViewData["CategoriaId"]">Anterior</a>
                </li>
                @for (var i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@ViewData["Buscar"]" asp-route-categoriaId="@ViewData["CategoriaId"]">@i</a>
                    </li>
                }
                <li class="page-item @(pagina == totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina + 1)" asp-route-buscar="@ViewData["Buscar"]" asp-route-categoriaId="@ViewData["CategoriaId"]">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
}
