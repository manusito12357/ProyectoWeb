@model proyectoweb.Models.Categoria

@{
    ViewData["Title"] = "Eliminar categoría";
    var cursos = ViewData["Cursos"] is int cantidad ? cantidad : 0;
}

<h1>Eliminar categoría</h1>

@if (cursos > 0)
{
    <div class="alert alert-warning">
        <strong>No se puede eliminar.</strong>
        Esta categoría tiene @(cursos == 1 ? "1 curso" : cursos + " cursos"). Cambia de categoría o elimina esos cursos primero.
    </div>
}
else
{
    <div class="alert alert-danger">
        <strong>Esta acción no se puede deshacer.</strong>
        La categoría no tiene cursos.
    </div>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
    <dd class="col-sm-9 text-capitalize">@Model.Nombre</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    @if (cursos == 0)
    {
        <button type="submit" class="btn btn-danger">Eliminar categoría</button>
    }
    <a asp-action="Index" class="btn btn-link">@(cursos == 0 ? "Cancelar" : "Volver a la lista")</a>
</form>
