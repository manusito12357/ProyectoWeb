@model proyectoweb.Models.Categoria

@{
    ViewData["Title"] = "Detalles de la categoría";
}

<h1>Detalles de la categoría</h1>

<div class="panel-admin">
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-9 text-capitalize">@Model.Nombre</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-link">Volver a la lista</a>
