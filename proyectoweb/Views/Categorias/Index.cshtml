@model IEnumerable<proyectoweb.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<div class="encabezado-lista">
    <h1>Categorías</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva categoría</a>
</div>

@if (!Model.Any())
{
    <p>Todavía no hay categorías. Crea la primera con el botón "Nueva categoría".</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="text-capitalize">@item.Nombre</td>
                    <td>
                        <div class="acciones">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </div>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
}
