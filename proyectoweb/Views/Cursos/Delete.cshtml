@model proyectoweb.Models.Curso

@{
    ViewData["Title"] = "Eliminar curso";
    var lecciones = (int)ViewData["Lecciones"]!;
    var inscritos = (int)ViewData["Inscritos"]!;

    string Cantidad(int n, string singular, string plural) => n == 1 ? "1 " + singular : n + " " + plural;
}

<h1>Eliminar curso</h1>

<div class="alert alert-danger">
    <strong>Esta acción no se puede deshacer.</strong>
    @if (lecciones > 0 || inscritos > 0)
    {
        <text>Se eliminará el curso junto con @Cantidad(lecciones, "lección", "lecciones") y @Cantidad(inscritos, "inscripción", "inscripciones"), incluido el progreso de esos suscriptores.</text>
    }
    else
    {
        <text>El curso no tiene lecciones ni inscritos.</text>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Titulo)</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Categoria)</dt>
    <dd class="col-sm-9 text-capitalize">@Model.Categoria?.Nombre</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nivel)</dt>
    <dd class="col-sm-9"><partial name="_EtiquetaNivel" model="Model.Nivel" /></dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DuracionMinutos)</dt>
    <dd class="col-sm-9">@Model.DuracionMinutos min</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@(Model.Publicado ? "Publicado" : "Borrador")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar curso</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
