@model IEnumerable<proyectoweb.Models.Curso>

@{
    ViewData["Title"] = "Cursos";
}

<div class="encabezado-lista">
    <h1>Cursos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo curso</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-auto">
        <select name="categoriaId" class="form-select" asp-items="ViewBag.Categorias">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        @if (ViewData["CategoriaId"] != null)
        {
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <p>@(ViewData["CategoriaId"] != null ? "No hay cursos en esa categoría." : "Todavía no hay cursos. Crea el primero con el botón \"Nuevo curso\".")</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Titulo)</th>
                    <th>@Html.DisplayNameFor(model => model.Categoria)</th>
                    <th>@Html.DisplayNameFor(model => model.Nivel)</th>
                    <th>@Html.DisplayNameFor(model => model.DuracionMinutos)</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td>@item.Titulo</td>
                    <td class="text-capitalize">@item.Categoria?.Nombre</td>
                    <td><partial name="_EtiquetaNivel" model="item.Nivel" /></td>
                    <td>@item.DuracionMinutos min</td>
                    <td>
                        @if (item.Publicado)
                        {
                            <span class="badge bg-success">Publicado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Borrador</span>
                        }
                    </td>
                    <td>
                        <div class="acciones">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-controller="Lecciones" asp-action="Index" asp-route-cursoId="@item.Id" class="btn btn-sm btn-outline-secondary">Lecciones</a>
                            <a asp-action="Inscritos" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Inscritos (@(item.Inscripciones?.Count ?? 0))</a>
                            <form asp-action="CambiarPublicacion" asp-route-id="@item.Id" method="post" onsubmit="@(item.Publicado ? "return confirm('¿Despublicar este curso? Dejará de verse en el catálogo.');" : null)">
                                <button type="submit" class="btn btn-sm @(item.Publicado ? "btn-outline-warning" : "btn-outline-success")">@(item.Publicado ? "Despublicar" : "Publicar")</button>
                            </form>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </div>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
}
