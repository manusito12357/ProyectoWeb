@model proyectoweb.Models.Curso

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Titulo" class="form-label"></label>
    <input asp-for="Titulo" class="form-control" />
    <span asp-validation-for="Titulo" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Nivel" class="form-label"></label>
    <select asp-for="Nivel" class="form-select" asp-items="Html.GetEnumSelectList<NivelCurso>()"></select>
    <span asp-validation-for="Nivel" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="DuracionMinutos" class="form-label"></label>
    <input asp-for="DuracionMinutos" class="form-control" />
    <span asp-validation-for="DuracionMinutos" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ImagenUrl" class="form-label"></label>
    <input asp-for="ImagenUrl" class="form-control" />
    <span asp-validation-for="ImagenUrl" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="CategoriaId" class="form-label"></label>
    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId"></select>
    <span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>
<div class="form-check mb-3">
    <input class="form-check-input" asp-for="Publicado" />
    <label class="form-check-label" asp-for="Publicado"></label>
</div>
