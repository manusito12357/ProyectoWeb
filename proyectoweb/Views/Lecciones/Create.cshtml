@model proyectoweb.Models.Leccion

@{
    ViewData["Title"] = "Nueva lección";
}

<h1>Nueva lección</h1>
<div class="panel-admin">
    <form asp-action="Create">
        <partial name="_CamposLeccion" />
        <button type="submit" class="btn btn-primary">Crear</button>
        <a asp-action="Index" asp-route-cursoId="@(Model.CursoId == 0 ? null : Model.CursoId)" class="btn btn-link">Volver a la lista</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
