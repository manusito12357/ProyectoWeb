@model proyectoweb.Models.ProgresoCurso

@{
    var curso = Model.Curso;
    var lecciones = curso.Lecciones!;
    var completadas = (HashSet<int>)ViewData["Completadas"]!;
    var proxima = lecciones.FirstOrDefault(l => !completadas.Contains(l.Id)) ?? lecciones.FirstOrDefault();
    var terminado = Model.Porcentaje == 100;
    ViewData["Title"] = curso.Titulo;
}

<nav class="ruta" aria-label="Ruta">
    <a asp-action="Index">Mis cursos</a>
    <span aria-hidden="true">/</span>
    <span>@curso.Titulo</span>
</nav>

<div class="detalle">
    <div>
        <h1>@curso.Titulo</h1>
        <div class="datos-curso">
            <partial name="_MedidorNivel" model="curso.Nivel" />
            <span>@curso.DuracionMinutos min</span>
        </div>
        <p class="descripcion-detalle">@curso.Descripcion</p>

        <h2 class="h4 mt-4">Lecciones</h2>
        @if (!lecciones.Any())
        {
            <p>Este curso todavía no tiene lecciones.</p>
        }
        else
        {
            <ol class="lista-lecciones">
                @foreach (var leccion in lecciones)
                {
                    var hecha = completadas.Contains(leccion.Id);
                    <li class="@(hecha ? "hecha" : "")">
                        <a asp-action="Leccion" asp-route-id="@leccion.Id">@leccion.Titulo</a>
                        @if (hecha)
                        {
                            <span class="bloqueada">Completada</span>
                        }
                    </li>
                }
            </ol>
        }
    </div>

    <aside class="tarjeta-detalle">
        <div class="p-3">
            <h2 class="h5">Tu progreso</h2>
            <p class="estado-curso @(terminado ? "terminado" : "")">@Model.Completadas de @Model.Total lecciones completadas</p>
            <div class="progress mb-3"><div class="progress-bar @(terminado ? "terminado" : "")" style="width: @(Model.Porcentaje)%"></div></div>
            @if (proxima != null)
            {
                <a asp-action="Leccion" asp-route-id="@proxima.Id" class="btn @(terminado ? "btn-outline-secondary" : "btn-destacado") w-100">@(terminado ? "Repasar desde el inicio" : "Continuar")</a>
            }
        </div>
    </aside>
</div>
