@model IEnumerable<proyectoweb.Models.ProgresoCurso>

@{
    ViewData["Title"] = "Mis cursos";
}

<h1>Mis cursos</h1>

@if (!Model.Any())
{
    <p>Todavía no te has inscrito en ningún curso. <a asp-controller="Catalogo" asp-action="Index">Ver el catálogo</a>.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.Curso.Titulo</h5>
                        <p class="text-muted mb-2">@item.Completadas de @item.Total lecciones completadas</p>
                        <div class="progress mb-3">
                            <div class="progress-bar" role="progressbar" style="width: @(item.Porcentaje)%">@item.Porcentaje%</div>
                        </div>
                        <a asp-action="Curso" asp-route-id="@item.Curso.Id" class="btn btn-primary btn-sm">@(item.Porcentaje == 100 ? "Repasar" : "Continuar")</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
