@model proyectoweb.Models.ResumenPanel

@{
    ViewData["Title"] = "Panel";

    var indicadores = new (string Texto, int Valor, string? Nota)[]
    {
        ("Cursos", Model.Cursos, Model.Publicados + " publicados, " + Model.Borradores + " en borrador"),
        ("Categorías", Model.Categorias, null),
        ("Lecciones", Model.Lecciones, null),
        ("Suscriptores", Model.Suscriptores, null),
        ("Inscripciones", Model.Inscripciones, null),
        ("Cursos terminados", Model.Terminados, "de " + Model.Inscripciones + " inscripciones"),
        ("Lecciones completadas", Model.LeccionesCompletadas, null)
    };
}

<div class="encabezado-lista">
    <h1>Panel del administrador</h1>
    <a asp-controller="Cursos" asp-action="Create" class="btn btn-destacado">Nuevo curso</a>
</div>

<div class="indicadores">
    @foreach (var (texto, valor, nota) in indicadores)
    {
        <div class="indicador">
            <div class="texto">@texto</div>
            <div class="valor">@valor</div>
            @if (nota != null)
            {
                <div class="nota">@nota</div>
            }
        </div>
    }
</div>

<h2 class="h4">Cursos con más inscritos</h2>
@if (!Model.Populares.Any())
{
    <p>Todavía no hay cursos.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Curso</th>
                    <th>Inscritos</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var curso in Model.Populares)
                {
                    <tr>
                        <td>@curso.Titulo</td>
                        <td>@curso.Inscritos</td>
                        <td class="text-end">
                            <a asp-controller="Cursos" asp-action="Inscritos" asp-route-id="@curso.Id" class="btn btn-sm btn-outline-secondary">Ver inscritos</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
