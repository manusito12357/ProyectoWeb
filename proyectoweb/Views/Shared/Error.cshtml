@model ErrorViewModel
@{
    var noEncontrado = Model.Codigo == 404;
    ViewData["Title"] = noEncontrado ? "Página no encontrada" : "Error";
}

<div class="card tarjeta-acceso text-center">
    <div class="card-body p-4">
        @if (noEncontrado)
        {
            <p class="display-4 text-muted mb-2">404</p>
            <h1 class="h3">Página no encontrada</h1>
            <p class="text-muted">La dirección que buscas no existe, o el curso ya no está disponible.</p>
        }
        else
        {
            <h1 class="h3 text-danger">Algo salió mal</h1>
            <p class="text-muted">Ocurrió un error al procesar tu solicitud. Intenta de nuevo en unos minutos.</p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted">Código de referencia: <code>@Model.RequestId</code></p>
            }
        }
        <a asp-area="" asp-controller="Catalogo" asp-action="Index" class="btn btn-primary">Volver al catálogo</a>
    </div>
</div>
