@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(params string[] nombres) => nombres.Contains(controlador) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Microcursos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/proyectoweb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark barra-principal mb-4">
            <div class="container">
                <a class="navbar-brand marca" asp-area="" asp-controller="Catalogo" asp-action="Index">
                    <span class="marca-icono"></span>Microcursos
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal"
                        aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <form class="buscador-barra" asp-area="" asp-controller="Catalogo" asp-action="Index" method="get" role="search">
                        <input type="search" name="buscar" value="@Context.Request.Query["buscar"]" class="form-control"
                               placeholder="Buscar cursos por título" aria-label="Buscar cursos" maxlength="150" />
                    </form>
                    <ul class="navbar-nav mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @Activo("Catalogo")" asp-area="" asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                        </li>
                        @if (User.IsInRole("Suscriptor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo("MisCursos")" asp-area="" asp-controller="MisCursos" asp-action="Index">Mis cursos</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo("Panel")" asp-area="" asp-controller="Panel" asp-action="Index">Panel</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Activo("Cursos", "Lecciones")" asp-area="" asp-controller="Cursos" asp-action="Index">Cursos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Activo("Categorias")" asp-area="" asp-controller="Categorias" asp-action="Index">Categorías</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Exito"] is string mensaje)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex justify-content-between">
            <span>&copy; 2026 Microcursos<span class="d-none d-sm-inline"> &middot; Aprende a tu ritmo</span></span>
            <span>
                <a asp-area="" asp-controller="Catalogo" asp-action="Index">Catálogo</a> &middot;
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
            </span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
